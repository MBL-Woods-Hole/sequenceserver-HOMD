---
:host: 0.0.0.0
:port: 4570
:databases_widget: default
:options:
  :blastn:
    :default:
    - "-task blastn"
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
    :custom:
    - "-task blastn"
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
  :blastp:
    :default:
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
    :custom:
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
  :blastx:
    :default:
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
  :tblastx:
    :default:
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
  :tblastn:
    :default:
    - "-evalue 1e-5"
    - "-max_target_seqs 20"
:num_threads: 4
:num_jobs: 1
:job_lifetime: 43200
#:database_dir: "/mnt/xvdb/blastdb/genomes_ncbi/current/"
:database_dir: "/home/ubuntu/blast-db-genome/genomes_ncbi_single/"
#:database_dir: "/mnt/efs/homd-dev/blastdb_testing/genomes_ncbi/current"
:bin: "/home/ubuntu/.sequenceserver-bin/ncbi-blast-2.16.0+/bin"
#:require: "/home/ubuntu/.sequenceserver-bin/db_type-genome-ncbi.rb"
#:require: "/home/ubuntu/.sequenceserver-bin/links-jbrowse-ncbi.rb"
#:require: "/home/ubuntu/.sequenceserver-bin/routes_testing.rb"
:devel: true
